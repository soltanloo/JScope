{
	"name": "coverage-as-promised",
	"description": "VSCode extension for promise coverage",
	"version": "0.0.1",
	"publisher": "mohganji",
	"engines": {
		"vscode": "^1.32.0"
	},
	"activationEvents": [
		"onCommand:cap.run-coverage",
		"onView:cap-view-container",
		"onView:cap-tree-view",
		"onView:cap-config-webview"
	],
	"main": "./out/extension.js",
	"contributes": {
		"productIconThemes": [
			{
				"id": "async-coverage-icons",
				"label": "Async Coverage Icons",
				"path": "./media/icons/async-coverage-product-icon-theme.json"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "cap-view-container",
					"title": "Async Coverage",
					"icon": "media/area.png"
				}
			]
		},
		"commands": [
			{
				"command": "cap.run-coverage",
				"title": "CAP: Run Promise Coverage"
			},
			{
				"command": "cap-config.update-config",
				"category": "CAP: Update Config",
				"title": "Update Promise Coverage Configurations",
				"icon": "$(clear-all)"
			},
			{
				"command": "right-click-menu.open-call-location",
				"title": "Go to Reference"
			},
			{
				"command": "right-click-menu.show-all-executions",
				"title": "Show All Executions"
			}
		],
		"views": {
			"cap-view-container": [
				{
					"id": "cap-config-webview",
					"type": "webview",
					"name": "Configure Promise Tree"
				},
				{
					"id": "cap-tree-view",
					"name": "Promise Coverage view"
				}
			]
		},
		"menus": {
			"view/item/context": [
				{
					"command": "right-click-menu.open-call-location",
					"when": "viewItem == AsyncStatementNode"
				},
				{
					"command": "right-click-menu.show-all-executions",
					"when": "viewItem == ReactionNode"
				}
			]
		}
	},
	"scripts": {
		"build": "npm run build:main && npm run compile && npm run build:pull-submodules && npm run build:build-submodules",
		"build:main": "npm i",
		"build:pull-submodules": "git submodule update --init",
		"build:build-submodules": "cd async-coverage && yarn install && cd ..",
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint . --ext .ts,.tsx",
		"watch": "tsc -watch -p ./",
		"test:integration": "node ./out/test/runTests.js integration",
		"test:unit": "node ./out/test/runTests.js unit",
		"test": "npm run test:unit && npm run test:integration",
		"build-n-test": "npm run build && npm run test",
		"clean:test": "rm -r out/test",
		"clean": "rm -r ./out"
	},
	"devDependencies": {
		"@types/glob": "^7.1.4",
		"@types/istanbul": "^0.4.30",
		"@types/mocha": "^9.0.0",
		"@types/node": "^12.12.0",
		"@types/vscode": "^1.32.0",
		"@typescript-eslint/eslint-plugin": "^4.16.0",
		"@typescript-eslint/parser": "^4.16.0",
		"eslint": "^7.21.0",
		"mocha": "^9.1.2",
		"typescript": "^4.2.2",
		"webfont": "^11.2.26"
	},
	"dependencies": {
		"@vscode/test-electron": "^1.6.2",
		"glob": "^7.2.0",
		"istanbul": "^0.4.5",
		"nyc": "^15.1.0",
		"vscode-test": "^1.6.1"
	}
}
